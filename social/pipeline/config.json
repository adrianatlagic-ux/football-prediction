{
  "api_base": "https://football-prediction.fly.dev",
  "website": "https://goaliq.de",
  "repository": "adrianatlagic-ux/football-prediction",
  "timezone": "Europe/Berlin",
  "monthly_credit_limit": null,
  "rolling_30_day_credit_limit": null,
  "rolling_7_day_credit_limit": null,
  "credit_floor": null,
  "post_credit_limit": null,
  "monthly_post_limit": null,
  "prediction_max_age_hours": 48,
  "minimum_lead_hours": 2,
  "minimum_editorial_score": 45,
  "publish_enabled": false,
  "team_relevance": {
    "Germany": 1,
    "England": 0.95,
    "Spain": 0.95,
    "France": 0.95,
    "Portugal": 0.9,
    "Italy": 0.9,
    "Netherlands": 0.85,
    "Croatia": 0.8,
    "Switzerland": 0.75,
    "Austria": 0.75,
    "Scotland": 0.65,
    "Bayern Munich": 1,
    "Borussia Dortmund": 0.95,
    "Real Madrid": 1,
    "Barcelona": 1,
    "Liverpool": 0.9,
    "Arsenal": 0.9,
    "Manchester City": 0.9,
    "Paris Saint-Germain": 0.9
  },
  "spoken_language": "fixture_based",
  "on_screen_language": "en",
  "language_validation_required": true,
  "processing_environment": "higgsfield_cloud_only",
  "local_processing_enabled": false,
  "python_enabled": false,
  "cloud_editor_internal_ffmpeg_enabled": true,
  "edit_mode": "generated_fixture_hook_in_source_append_goalfiq_outro_only",
  "preserve_source_video": true,
  "preserve_source_audio": true,
  "reuse_scenes_from_other_versions": false,
  "force_target_duration": false,
  "prefer_source_stream_copy": true,
  "final_output": "single_mp4_inline_chat_with_direct_download_link",
  "outro": {
    "logo_path": "social/pipeline/assets/goal-logo.png",
    "domain": "goaliq.de",
    "disclaimer_en": "AI predictions, for entertainment only. No betting advice.",
    "layout": [
      "original_logo",
      "domain",
      "bottom_disclaimer"
    ],
    "duration_seconds": 3,
    "additional_cta": false
  },
  "daily_video_limit": 1,
  "daily_limit_basis": "editorial_target_date",
  "budget_ledger_required": false,
  "cloud_daily_manifest_pattern": "social/pipeline/cloud/YYYY-MM-DD/manifest.json",
  "story_diversity": {
    "required": true,
    "repeat_previous_story_type": false,
    "minimum_changed_elements": 3,
    "forbidden_template": "interview_question_then_player_answer_then_standard_pitch_duel",
    "manifest_fields": [
      "story_type",
      "hook",
      "conflict",
      "turning_point",
      "ending_image",
      "previous_story_type"
    ],
    "story_types": [
      "object_mystery",
      "time_pressure_mission",
      "rivalry_riddle",
      "environmental_obstacle",
      "perspective_shift",
      "misdirected_expectation",
      "team_internal_decision"
    ]
  },
  "caption_language": "de",
  "caption_required": true,
  "caption_output": "inline_chat_and_caption_txt_and_manifest",
  "caption_style": {
    "attention_hook": true,
    "controversial_discussion": true,
    "story_specific": true,
    "avoid_repeated_template": true,
    "virality_guarantee": false,
    "fiction_label_required": true,
    "domain": "goaliq.de",
    "disclaimer_de": "KI-Prognosen, nur zur Unterhaltung. Keine Wettberatung.",
    "explanatory_story_summary": false,
    "fiction_label_format": "KI-Fiktion",
    "avoid_phrases": [
      "In unserer fiktiven KI-Anime-Story"
    ],
    "story_reference": "implicit_in_hook_or_question_without_explanatory_summary"
  },
  "visual_style": {
    "required": true,
    "type": "photorealistic_live_action",
    "traits": [
      "natural human appearance",
      "cinematic live action",
      "verified current player likenesses"
    ],
    "photorealistic": true,
    "validation_required": true
  },
  "fixture_hook": {
    "required": true,
    "duration_seconds": 2,
    "placement": "opening_inside_generated_story_video",
    "text_renderer": "higgsfield_video_generation",
    "language": "en",
    "line_templates": [
      "{HOME_EN} vs {AWAY_EN}",
      "{RELATIVE_DAY_EN} · {HH:MM} {CET_OR_CEST}"
    ],
    "timezone": "Europe/Berlin",
    "source": "live_verified_fixture",
    "relative_day_must_match_delivery_date": true,
    "background": "generated_photorealistic_scene",
    "source_video_overlay": false,
    "speech": false,
    "validation_required": true,
    "future_day_template": "{D} {MON_EN} {YYYY} · {HH:MM} {CET_OR_CEST}",
    "future_date_required": true,
    "render_mode": "inside_generated_story_video",
    "post_generation_text_overlay": false,
    "separate_intro": false,
    "team_crests": {
      "required": true,
      "enabled": true,
      "placement": "very_beginning",
      "source": "authorized_assets_or_official_team_sources",
      "reference_media_required": true,
      "team_assignment_validation_required": true,
      "shape_and_legibility_validation_required": true
    },
    "opening_content": [
      "official_team_crests",
      "team_names",
      "verified_match_date_and_kickoff"
    ]
  },
  "source_hash_comparison_offset": 0,
  "fixture_selection": {
    "mode": "today_then_nearest_upcoming_uncovered_matchday",
    "daily_production_goal": 1,
    "upcoming_preview_enabled": true,
    "explicit_preview_request_required": false,
    "chronological_matchdays": true,
    "rank_within_nearest_valid_matchday": true,
    "skip_previously_reserved_or_covered_fixture": true,
    "coverage_source": "repository_cloud_manifests",
    "coverage_fields": [
      "match_id",
      "home_team",
      "away_team",
      "match_date"
    ],
    "invalid_candidate_action": "record_reason_then_check_next_candidate_or_matchday",
    "no_today_matches_action": "look_ahead",
    "no_valid_available_fixture_action": "report_blocker",
    "preserve_data_credit_and_quality_checks": true,
    "research_only_ranking": [
      "team_relevance",
      "verified_current_context",
      "story_potential"
    ],
    "prediction_absence_is_blocker": false,
    "minimum_editorial_score_without_prediction": null
  },
  "editorial_date_policy": {
    "target_date": "intended_content_day_europe_berlin",
    "match_date": "actual_fixture_date_separate",
    "upcoming_preview_consumes": "editorial_day_only",
    "historical_manifests": "do_not_redate"
  },
  "prediction_required": false,
  "generation_basis": "verified_fixture_and_current_research",
  "prediction_policy": {
    "role": "optional_internal_selection_aid",
    "missing_action": "continue_fixture_and_research",
    "missing_freshness_action": "omit_prediction_and_continue",
    "stale_action": "omit_prediction_and_continue",
    "max_age_hours": 48,
    "impute_probabilities": false
  },
  "correction_policy": {
    "obey_user_authorized_run_cap": true,
    "store_in_daily_manifest": true,
    "do_not_retry_when_cap_exhausted": true
  },
  "voice_quality": {
    "required": true,
    "spoken_language": "fixture_based",
    "style": "natural_human_conversational",
    "traits": [
      "credible emotion",
      "varied intonation",
      "natural pauses",
      "clear articulation"
    ],
    "avoid": [
      "robotic",
      "metallic",
      "monotonous",
      "exaggerated synthetic anime voices"
    ],
    "real_person_imitation": false,
    "actual_audio_review_required": true
  },
  "delivery": {
    "inline_media_player": true,
    "direct_mp4_download_link_required": true,
    "download_link_label": "Video herunterladen (MP4)",
    "link_target": "confirmed_final_composite_mp4",
    "verify_link_reachable": true,
    "caption_inline_required": true,
    "private_media_urls_in_public_repository": false,
    "repeat_download_request_action": "reuse_existing_final_without_generation",
    "zip_download_fallback_required": true,
    "zip_contains": "same_final_mp4_byte_identical",
    "download_archive_renderer": "higgsfield_cloud_only",
    "zip_label": "Video herunterladen (ZIP mit MP4)"
  },
  "spoken_language_policy": {
    "german_participation": "de",
    "other_matches": "en",
    "german_participation_definition": [
      "German club in domestic or international competition",
      "German national team"
    ],
    "on_screen_language": "en",
    "outro_language": "en",
    "caption_language": "de",
    "manifest_language_and_reason_required": true
  },
  "story_relevance": {
    "required": true,
    "basis": "verified_match_or_club_context",
    "context_types": [
      "match",
      "club"
    ],
    "minimum_substantive_verified_context_points": 1,
    "acceptable_context": [
      "sporting context",
      "verified tactical contrast",
      "rivalry",
      "fans",
      "stadium tradition",
      "club identity",
      "verified club history",
      "official squad news"
    ],
    "historical_and_enduring_club_context_allowed": true,
    "team_names_colors_crests_alone_sufficient": false,
    "exchangeability_test_required": true,
    "actual_video_review_required": true,
    "unrelated_fantasy_obstacle_allowed": false,
    "fiction_label_required": true,
    "source_attribution_required": true,
    "manifest_fields": [
      "context_type",
      "verified_context",
      "story_connection",
      "spoken_language",
      "relevance_review"
    ]
  },
  "player_likeness": {
    "allowed": true,
    "current_team_verification_required": true,
    "official_visual_references_required": true,
    "fiction_label_required": true,
    "real_voice_cloning": false,
    "authentic_quote_claims": false
  }
}
