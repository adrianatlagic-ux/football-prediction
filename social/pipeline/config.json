{
  "api_base": "https://football-prediction.fly.dev",
  "website": "https://goaliq.de",
  "repository": "adrianatlagic-ux/football-prediction",
  "timezone": "Europe/Berlin",
  "monthly_credit_limit": null,
  "rolling_30_day_credit_limit": null,
  "rolling_7_day_credit_limit": null,
  "credit_floor": null,
  "post_credit_limit": null,
  "monthly_post_limit": null,
  "prediction_max_age_hours": 48,
  "minimum_lead_hours": 2,
  "minimum_editorial_score": 45,
  "publish_enabled": false,
  "team_relevance": {
    "Germany": 1,
    "England": 0.95,
    "Spain": 0.95,
    "France": 0.95,
    "Portugal": 0.9,
    "Italy": 0.9,
    "Netherlands": 0.85,
    "Croatia": 0.8,
    "Switzerland": 0.75,
    "Austria": 0.75,
    "Scotland": 0.65,
    "Bayern Munich": 1,
    "Borussia Dortmund": 0.95,
    "Real Madrid": 1,
    "Barcelona": 1,
    "Liverpool": 0.9,
    "Arsenal": 0.9,
    "Manchester City": 0.9,
    "Paris Saint-Germain": 0.9
  },
  "spoken_language": "en",
  "on_screen_language": "en",
  "language_validation_required": true,
  "processing_environment": "higgsfield_cloud_only",
  "local_processing_enabled": false,
  "python_enabled": false,
  "cloud_editor_internal_ffmpeg_enabled": true,
  "edit_mode": "prepend_fixture_hook_preserve_story_append_goalfiq_outro",
  "preserve_source_video": true,
  "preserve_source_audio": true,
  "reuse_scenes_from_other_versions": false,
  "force_target_duration": false,
  "prefer_source_stream_copy": true,
  "final_output": "single_mp4_inline_chat",
  "outro": {
    "logo_path": "social/pipeline/assets/goal-logo.png",
    "domain": "goaliq.de",
    "disclaimer_en": "AI predictions, for entertainment only. No betting advice.",
    "layout": [
      "original_logo",
      "domain",
      "bottom_disclaimer"
    ],
    "duration_seconds": 3,
    "additional_cta": false
  },
  "daily_video_limit": 1,
  "daily_limit_basis": "editorial_target_date",
  "budget_ledger_required": false,
  "cloud_daily_manifest_pattern": "social/pipeline/cloud/YYYY-MM-DD/manifest.json",
  "story_diversity": {
    "required": true,
    "repeat_previous_story_type": false,
    "minimum_changed_elements": 3,
    "forbidden_template": "interview_question_then_player_answer_then_standard_pitch_duel",
    "manifest_fields": [
      "story_type",
      "hook",
      "conflict",
      "turning_point",
      "ending_image",
      "previous_story_type"
    ],
    "story_types": [
      "object_mystery",
      "time_pressure_mission",
      "rivalry_riddle",
      "environmental_obstacle",
      "perspective_shift",
      "misdirected_expectation",
      "team_internal_decision"
    ]
  },
  "caption_language": "de",
  "caption_required": true,
  "caption_output": "inline_chat_and_caption_txt_and_manifest",
  "caption_style": {
    "attention_hook": true,
    "controversial_discussion": true,
    "story_specific": true,
    "avoid_repeated_template": true,
    "virality_guarantee": false,
    "fiction_label_required": true,
    "domain": "goaliq.de",
    "disclaimer_de": "KI-Prognosen, nur zur Unterhaltung. Keine Wettberatung."
  },
  "visual_style": {
    "required": true,
    "type": "2d_anime",
    "traits": [
      "drawn outlines",
      "cel shading",
      "expressive illustrated characters",
      "dynamic anime motion"
    ],
    "photorealistic": false,
    "realistic_3d_humans": false,
    "validation_required": true
  },
  "fixture_hook": {
    "required": true,
    "duration_seconds": 2,
    "placement": "before_full_story_source",
    "text_renderer": "higgsfield_native_cloud_editor",
    "language": "en",
    "line_templates": [
      "{HOME_EN} vs {AWAY_EN}",
      "{RELATIVE_DAY_EN} · {HH:MM} {CET_OR_CEST}"
    ],
    "timezone": "Europe/Berlin",
    "source": "live_verified_fixture",
    "relative_day_must_match_delivery_date": true,
    "background": "same_story_anime_opening",
    "source_video_overlay": false,
    "speech": false,
    "validation_required": true
  },
  "source_hash_comparison_offset": "fixture_hook_duration"
}
